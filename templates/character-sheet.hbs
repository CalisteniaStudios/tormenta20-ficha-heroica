<form class="tormenta20 tabbed t20ga-sheet" autocomplete="off">
  <div
    class="t20ga-shell"
    style="--t20ga-hero-panel-width: calc({{t20ga.campaignLogoPanelWidth}}% + {{t20ga.campaignLogoHorizontalSpace}}px);"
  >
    <aside class="t20ga-hero-panel">
      <div class="t20ga-brand">
        <button class="t20ga-brand-config" type="button" title="Personalizar aparência" aria-label="Personalizar a aparência desta ficha">
          {{#if t20ga.campaignLogo}}
          <span
            class="t20ga-campaign-logo-frame"
            style="--t20ga-campaign-logo-scale: {{t20ga.campaignLogoScale}}; --t20ga-campaign-logo-padding-top: {{t20ga.campaignLogoPaddingTop}}px; --t20ga-campaign-logo-padding-right: {{t20ga.campaignLogoPaddingRight}}px; --t20ga-campaign-logo-padding-bottom: {{t20ga.campaignLogoPaddingBottom}}px; --t20ga-campaign-logo-padding-left: {{t20ga.campaignLogoPaddingLeft}}px;"
          >
            <img
              class="t20ga-campaign-logo"
              src="{{t20ga.campaignLogo}}"
              alt="{{t20ga.campaignLogoAlt}}"
            />
          </span>
          {{else}}
          <span class="t20ga-brand-placeholder">
            <strong>Logo da campanha</strong>
            <small>Edição nas configurações</small>
          </span>
          {{/if}}
        </button>
        {{#if t20ga.campaignTitle}}
        <span class="t20ga-brand-caption">{{t20ga.campaignTitle}}</span>
        {{/if}}
      </div>

      <div class="t20ga-hero-frame">
        <span class="t20ga-hero-sigil" aria-hidden="true"></span>
        <img
          class="t20ga-hero-art-backdrop"
          src="{{actor.img}}"
          alt=""
          aria-hidden="true"
        />
        <img
          class="profile t20ga-hero-art"
          src="{{actor.img}}"
          alt="{{actor.name}}"
          title="Clique para trocar a imagem selecionada"
        />
        <div class="t20ga-art-vignette" aria-hidden="true"></div>
      </div>

      <div class="t20ga-hero-caption">
        <span class="t20ga-preview-label">{{actor.name}}</span>
        <div class="t20ga-art-controls">
          <button
            class="t20ga-art-switch"
            type="button"
            role="switch"
            aria-checked="false"
            data-avatar="{{t20ga.avatarArt}}"
            data-token="{{t20ga.tokenArt}}"
            title="Alternar entre avatar e token"
          >
            <span class="t20ga-switch-label">Avatar</span>
            <span class="t20ga-switch-track" aria-hidden="true">
              <span class="t20ga-switch-thumb"></span>
            </span>
            <span class="t20ga-switch-label">Token</span>
          </button>
          <button class="t20ga-art-adjust" type="button" title="Ajustar posição e escala da arte">
            <i class="fa-solid fa-sliders"></i>
            Ajustar
          </button>
        </div>
      </div>
    </aside>

    <main class="t20ga-main">
      <header class="sheet-header t20ga-character-header flexrow">
        <section class="header-details flexcol">
          <div class="general-information flexrow">
            <div class="t20ga-name-block">
              {{#if t20ga.unlinkedToken}}
              <span class="t20ga-link-warning" title="Este token não está vinculado aos dados do ator.">
                <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                Ficha não vinculada ao ator — mudanças podem ser perdidas
              </span>
              {{/if}}
              {{#if t20ga.groupName}}
              <span class="t20ga-kicker">{{t20ga.groupName}}</span>
              {{/if}}
              <h1 class="charname">
                <input
                  name="name"
                  type="text"
                  value="{{actor.name}}"
                  placeholder="{{localize 'T20.Name'}}"
                />
              </h1>
            </div>

            <aside class="header-exp flexcol">
              <div class="charlevel flexrow">
                <a class="config-button" data-action="resources" title="{{localize 'T20.Edit'}}">
                  <i class="fa-solid fa-heart-pulse"></i>
                </a>
                <a class="config-button" data-action="rest" title="{{localize 'T20.Rest'}}">
                  <i class="fa-solid fa-campground"></i>
                </a>
                <div class="level">{{localize 'T20.Level'}} {{system.attributes.nivel.value}}</div>
              </div>

              {{#unless disableExperience}}
              <div class="experience flexrow">
                <input
                  type="text"
                  placeholder="0"
                  data-dtype="Number"
                  name="system.attributes.nivel.xp.value"
                  value="{{system.attributes.nivel.xp.value}}"
                />
                <span class="sep">/</span>
                <span class="max-xp">{{system.attributes.nivel.xp.proximo}}</span>
              </div>
              <div class="xpbar" title="Experiência">
                <span class="bar" style="width: {{system.attributes.nivel.xp.pct}}%"></span>
              </div>
              {{/unless}}
            </aside>
          </div>

          {{> "t20ga.sheet-header-summary" }}
        </section>
      </header>

      {{#if t20ga.classicLayout}}
      <nav class="sheet-tabs tabs primary flexrow t20ga-classic-nav" data-group="primary">
        <a class="item" data-tab="attributes"><i class="fa-solid fa-file-invoice"></i> Ficha</a>
        <a class="item" data-tab="journal"><i class="fa-solid fa-book"></i> Diário</a>
        <a class="item" data-tab="effects"><i class="fa-solid fa-wand-magic-sparkles"></i> Efeitos</a>
      </nav>

      <section class="sheet-body t20ga-sheet-body t20ga-classic-body">
        <div class="tab attributes t20ga-classic-page" data-group="primary" data-tab="attributes">
          <div class="t20ga-classic-left">
            <section class="t20ga-vitals t20ga-classic-vitals">
              <div class="t20ga-abilities">
                {{> "t20ga.abilities"}}
              </div>
              <ul class="attributes t20ga-resources flexrow">
                {{> "t20ga.resources"}}
                {{> "t20ga.defense"}}
              </ul>
            </section>

            <section class="t20ga-card t20ga-classic-card t20ga-classic-weapons">
              <div class="t20ga-section-ribbon">Armas</div>
              {{> "t20ga.list-weapon"}}
            </section>

            <section class="t20ga-card t20ga-classic-card t20ga-classic-equipment">
              <div class="t20ga-section-ribbon">Equipamentos</div>
              {{> "t20ga.list-equipment"}}
            </section>

            <section class="t20ga-card t20ga-classic-card t20ga-classic-powers">
              <div class="t20ga-section-ribbon">Poderes</div>
              {{> "t20ga.list-powers-tabbed"}}
            </section>

            {{#if actor.maiorCirculo}}
            <section class="t20ga-card t20ga-classic-card t20ga-classic-spells">
              <div class="t20ga-section-ribbon">Magias</div>
              {{> "t20ga.list-spells"}}
            </section>
            {{/if}}

            <section class="t20ga-card t20ga-classic-card t20ga-traits-card">
              <div class="t20ga-section-ribbon">Traços e detalhes</div>
              <div class="traits">
                {{> "t20ga.traits"}}
                <textarea name="system.detalhes.info" rows="8">{{system.detalhes.info}}</textarea>
              </div>
            </section>
          </div>

          <aside class="t20ga-classic-right">
            <section class="t20ga-card t20ga-classic-card t20ga-skills-card">
              <div class="t20ga-section-ribbon">Perícias</div>
              {{> "t20ga.list-skills"}}
            </section>

            {{#if t20ga.hasFavorites}}
            <section class="t20ga-card t20ga-classic-card t20ga-favorites-card">
              <div class="t20ga-section-ribbon">Favoritos</div>
              <div class="t20ga-favorites-list">
                {{> "t20ga.list-favorites"}}
              </div>
            </section>
            {{/if}}

            <section class="t20ga-card t20ga-classic-card t20ga-classic-inventory">
              <div class="t20ga-section-ribbon">Inventário</div>
              <header class="flexrow">
                {{> "t20ga.currency"}}
                <div class="item-controls">
                  <a class="button item-control item-dialog" data-type="gerais" data-tooltip="Criar Item">
                    <i class="fas fa-plus"></i>
                  </a>
                </div>
              </header>
              <div class="inventory-list">
                {{> "t20ga.list-consumable"}}
                {{> "t20ga.list-loot"}}
              </div>
              {{> "t20ga.encumbrance"}}
            </section>

            <section class="t20ga-card t20ga-classic-card t20ga-classic-modifiers">
              <div class="t20ga-section-ribbon">Modificadores</div>
              {{> "t20ga.modifiers"}}
            </section>
          </aside>
        </div>

        <div class="tab journal t20ga-card flexrow flex-between" data-group="primary" data-tab="journal">
          {{> "t20ga.journal"}}
        </div>

        <div class="tab effects t20ga-card" data-group="primary" data-tab="effects">
          {{> "t20ga.active-effects"}}
        </div>
      </section>
      {{else}}
      <section class="t20ga-vitals">
        <div class="t20ga-abilities">
          {{> "t20ga.abilities"}}
        </div>
        <ul class="attributes t20ga-resources flexrow">
          {{> "t20ga.resources"}}
          {{> "t20ga.defense"}}
        </ul>
      </section>

      {{> "t20ga.nav-bar"}}

      <section class="sheet-body t20ga-sheet-body">
        <div class="tab attributes t20ga-dashboard flexrow" data-group="primary" data-tab="attributes">
          <section class="t20ga-card t20ga-skills-card">
            <div class="t20ga-section-ribbon">Perícias</div>
            {{> "t20ga.list-skills"}}
          </section>

          <div class="t20ga-dashboard-side flexcol">
            {{#if t20ga.hasFavorites}}
            <section class="t20ga-card t20ga-favorites-card">
              <div class="t20ga-section-ribbon">Favoritos</div>
              <div class="t20ga-favorites-list">
                {{> "t20ga.list-favorites"}}
              </div>
            </section>
            {{/if}}

            <section class="t20ga-card t20ga-traits-card">
              <div class="t20ga-section-ribbon">Traços e detalhes</div>
              <div class="traits">
                {{> "t20ga.traits"}}
                <textarea name="system.detalhes.info" rows="8">{{system.detalhes.info}}</textarea>
              </div>
            </section>
          </div>
        </div>

        <div class="tab inventory t20ga-card" data-group="primary" data-tab="inventory">
          {{> "t20ga.list-inventory"}}
        </div>

        <div class="tab powers t20ga-card" data-group="primary" data-tab="powers">
          {{> "t20ga.list-powers-tabbed"}}
        </div>

        <div class="tab spells t20ga-card" data-group="primary" data-tab="spells">
          {{> "t20ga.list-spells"}}
        </div>

        <div class="tab journal t20ga-card flexrow flex-between" data-group="primary" data-tab="journal">
          {{> "t20ga.journal"}}
        </div>

        <div class="tab modifiers t20ga-card" data-group="primary" data-tab="modifiers">
          {{> "t20ga.modifiers"}}
        </div>

        <div class="tab effects t20ga-card" data-group="primary" data-tab="effects">
          {{> "t20ga.active-effects"}}
        </div>
      </section>
      {{/if}}
    </main>
  </div>
</form>
