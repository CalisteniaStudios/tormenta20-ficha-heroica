<form class="t20ga-campaign-identity-form" autocomplete="off">
  <p class="t20ga-dialog-help">
    Esta identidade pertence ao mundo e será exibida da mesma forma para todos os jogadores.
  </p>

  <div class="t20ga-campaign-logo-preview {{#if identity.logo}}has-logo{{/if}}">
    {{#if identity.logo}}
    <img
      src="{{identity.logo}}"
      alt="Prévia da logo da campanha"
    />
    {{else}}
    <span><strong>Logo da campanha</strong><small>Edição nas configurações</small></span>
    {{/if}}
  </div>

  <label>
    <span>Arquivo da logo</span>
    <div class="t20ga-campaign-file-row">
      <input type="text" name="logo" value="{{identity.logo}}" placeholder="Nenhuma logo selecionada" />
      <button type="button" data-action="browse-logo" title="Escolher imagem">
        <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
      </button>
      <button type="button" data-action="remove-logo" title="Remover logo">
        <i class="fa-solid fa-trash" aria-hidden="true"></i>
      </button>
    </div>
  </label>

  <fieldset class="t20ga-campaign-logo-adjustments">
    <legend>Ajuste da logo</legend>
    <label>
      <span>Escala <output data-output="logoScale">{{identity.logoScale}}×</output></span>
      <input type="range" name="logoScale" min="0.5" max="1.8" step="0.01" value="{{identity.logoScale}}" />
    </label>
    <label>
      <span>Posição horizontal <output data-output="logoPositionX">{{identity.logoPositionX}}px</output></span>
      <input type="range" name="logoPositionX" min="-60" max="60" step="1" value="{{identity.logoPositionX}}" />
    </label>
    <label>
      <span>Posição vertical <output data-output="logoPositionY">{{identity.logoPositionY}}px</output></span>
      <input type="range" name="logoPositionY" min="-40" max="40" step="1" value="{{identity.logoPositionY}}" />
    </label>
    <button type="button" class="t20ga-dialog-reset" data-action="reset-logo-transform">
      <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
      Restaurar enquadramento
    </button>
  </fieldset>

  <label>
    <span>Título da campanha</span>
    <input type="text" name="title" maxlength="80" value="{{identity.title}}" placeholder="Opcional" />
  </label>
  <label class="t20ga-campaign-checkbox">
    <input type="checkbox" name="showTitle" {{checked identity.showTitle}} />
    <span>Mostrar o título abaixo da logo</span>
  </label>

  <label>
    <span>Nome do grupo</span>
    <input type="text" name="groupName" maxlength="80" value="{{identity.groupName}}" placeholder="Opcional" />
  </label>
  <label class="t20ga-campaign-checkbox">
    <input type="checkbox" name="showGroupName" {{checked identity.showGroupName}} />
    <span>Mostrar o nome do grupo na ficha</span>
  </label>

  <footer>
    <button type="submit">
      <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
      Salvar identidade da campanha
    </button>
  </footer>
</form>
